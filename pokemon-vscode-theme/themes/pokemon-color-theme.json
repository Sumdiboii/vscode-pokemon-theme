  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4A7C59",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6B46C1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings and text",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.other.symbol",
        "markup.quote",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4A7C59"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "support.variable",
        "meta.definition.variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2B2D42"
      }
    },
    {
      "name": "Properties and constants",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "constant",
        "constant.language",
        "constant.numeric",
        "constant.character",
        "entity.name.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#2B2D42"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.function.definition",
        "support.function",
        "support.function.builtin",
        "meta.function-call",
        "variable.function",
        "entity.name.method",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#2B6CB0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#2B6CB0"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#2B2D42"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.operator"
      ],
      "settings": {
        "foreground": "#6B46C1"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#9E1B1B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.bold",
        "markup.italic",
        "markup.underline"
      ],
      "settings": {
        "foreground": "#D99B26",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid and deprecated code",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#F0F0EA",
        "background": "#9E1B1B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags and attributes",
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#6B46C1"
      }
    },
    {
      "name": "Language support",
      "scope": [
        "support.type.primitive",
        "support.other",
        "support.other.variable"
      ],
      "settings": {
        "foreground": "#2B6CB0"
      }
    }
  ]
}