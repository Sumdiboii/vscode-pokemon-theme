  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A4A4A4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E3350D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings and text",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.other.symbol",
        "markup.quote",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#C59B00"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "support.variable",
        "meta.definition.variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#1A1A1A"
      }
    },
    {
      "name": "Properties and constants",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "constant",
        "constant.language",
        "constant.numeric",
        "constant.character",
        "entity.name.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#1A1A1A"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.function.definition",
        "support.function",
        "support.function.builtin",
        "meta.function-call",
        "variable.function",
        "entity.name.method",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#333333",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#333333"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#1A1A1A"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.operator"
      ],
      "settings": {
        "foreground": "#E3350D"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#E3350D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.bold",
        "markup.italic",
        "markup.underline"
      ],
      "settings": {
        "foreground": "#C59B00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid and deprecated code",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#E3350D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags and attributes",
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E3350D"
      }
    },
    {
      "name": "Language support",
      "scope": [
        "support.type.primitive",
        "support.other",
        "support.other.variable"
      ],
      "settings": {
        "foreground": "#333333"
      }
    }
  ]
}