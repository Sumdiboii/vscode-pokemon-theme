  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6272a4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ef5350",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings and text",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.other.symbol",
        "markup.quote",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#ffcb05"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "support.variable",
        "meta.definition.variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Properties and constants",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "constant",
        "constant.language",
        "constant.numeric",
        "constant.character",
        "entity.name.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.function.definition",
        "support.function",
        "support.function.builtin",
        "meta.function-call",
        "variable.function",
        "entity.name.method",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#4ba8ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#4ba8ff"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#f8f9fa"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.operator"
      ],
      "settings": {
        "foreground": "#ef5350"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#ef5350",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.bold",
        "markup.italic",
        "markup.underline"
      ],
      "settings": {
        "foreground": "#ffcb05",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid and deprecated code",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#ef5350",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags and attributes",
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ef5350"
      }
    },
    {
      "name": "Language support",
      "scope": [
        "support.type.primitive",
        "support.other",
        "support.other.variable"
      ],
      "settings": {
        "foreground": "#4ba8ff"
      }
    }
  ]
}